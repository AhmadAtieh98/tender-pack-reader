.venv/
__pycache__/
*.pyc
.pytest_cache/
tests/fixtures/out/
tenderpack.egg-info/
show/
rehearsals/*/build/
rehearsals/*/show/
rehearsals/*/out-*/review/
rehearsals/*/*.failed/
# AI workflow runs (session 10): the rebuildable parts of a candidate workspace are not committed (ingest and the
# out-before cache recreate them); the candidate curation, outputs, review packets, proposals and checkpoints are
staging/ai/runs/*/candidate/build/
staging/ai/runs/*/candidate/build.failed/
staging/ai/runs/*/candidate/out-before/
staging/ai/runs/*/candidate/before/
staging/ai/runs/*/candidate/out/review/
staging/ai/runs/_cache/
