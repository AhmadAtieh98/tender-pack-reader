{"event": "submitted", "proposal": {"addendum": "ADD-03", "items": [{"dependencies": ["VOL-IV:F4-A"], "evidence": [{"doc": "ADD-03", "kind": "span", "page": 1, "unit_id": "ADD-03:cover/para3", "words": "Bidders shall acknowledge receipt in Form 4-A."}], "id": "ADD-03/cover/para3", "model_rationale": "Same treatment as ADD-01/ADD-02 cover/para3 (annotate, adds_obligation). Summary items are handled via operative provisions; discrepancies flagged in separate issue items.", "payload": {"effect": "adds_obligation", "id": "ADD-03/cover/para3", "note": "Bidders shall acknowledge receipt of Addendum No. 3 in Form 4-A. The other changes listed in this summary are made by the operative provisions of Sections 2 to 5 and Appendix A (other batches); this summary is not itself an op on VOL-II 1.3, 7.2, 8.1-8.3 or VOL-V 31.1.", "old_resolved": "quoted", "origin": "assistant", "provision": "ADD-03:cover/para3", "targets": ["ADD-03:cover/para3"], "type": "annotate"}, "provision": "ADD-03:cover/para3", "state": {"activity_templates_sha256": "8f720c1d04e5f6d1926872e7bdeca2e28537782912cdc237796e2fe98e30d005", "amendments_sha256": "cec31d3931c953f5505c6db86b1f5b1b73e8b52e3817b7c29c409ea616489cca", "assumptions_sha256": "be5a1ecc966dab8d311cb4688827e56b9cd41f28053de21b5fb262fea446b1e0", "curation_sha256": "2cdf3faa6c1aed208a7e7fc24b6ca69c8a329fe41ffd4faa409c2cc5cc6c93b6", "decisions_sha256": null, "evidence_build_id": "f826cdeb7fbc262e1674323070670587be772af004e2a8855ab00b9209fb5848", "pack_id": "NUPA-ISTP-2026-014+ADD-03-CANDIDATE", "readings_sha256": "16b1b63f693c0dbd0db29c29700dae71525df534d9f300373aa0fd3b5d292bbf", "register_sha256": "8fa0072209651dfb94d0862e5cac287415c02ac8c85d7e02f0404990aa647ff5", "relationships_sha256": "1e6f35c25cd34a8718fff3d6ac2a8ce8b86821e3211c270742a64caa9b4c3052", "unrecorded_crops_sha256": null, "validated_stage": "ADD-02", "working_stage": "ADD-03"}, "statement_type": "amendment_op", "statements": ["S1", "S4"], "target": "ADD-03:cover/para3"}, {"dependencies": ["ADD-03:2.5"], "evidence": [{"doc": "ADD-03", "kind": "span", "page": 1, "unit_id": "ADD-03:cover/para3", "words": "to obtain the Authority's acceptance of its shutdown programme, applications for which shall be made within eight (8) Working Days of the date of this Addendum"}, {"doc": "ADD-03", "kind": "span", "page": 1, "unit_id": "ADD-03:2.5", "words": "Applications for a Shutdown Acceptance Letter shall be made to the Network Operator not later than eight (8) Working Days before the Proposal Due Date."}], "id": "ADD-03/cover/para3/issue-shutdown", "model_rationale": "Dates are not computed here; use calculate when the deadline is planned.", "payload": {"owner": null, "short": "Tie-in shutdown application deadline: cover vs Clause 2.5", "text": "The ADD-03 cover summary and operative Clause 2.5 disagree on the tie-in shutdown application. The cover says 'the Authority's acceptance' with applications 'within eight (8) Working Days of the date of this Addendum'. Clause 2.5 says a Network Operator letter, applied for 'not later than eight (8) Working Days before the Proposal Due Date'. These give different deadlines (forward from 10 November 2026 vs backward from the PDD) and different addressees. Plan to the earlier of the two deadlines and confirm with the Authority which one governs.", "theme": "tie-ins / programme"}, "provision": "ADD-03:cover/para3", "state": {"activity_templates_sha256": "8f720c1d04e5f6d1926872e7bdeca2e28537782912cdc237796e2fe98e30d005", "amendments_sha256": "cec31d3931c953f5505c6db86b1f5b1b73e8b52e3817b7c29c409ea616489cca", "assumptions_sha256": "be5a1ecc966dab8d311cb4688827e56b9cd41f28053de21b5fb262fea446b1e0", "curation_sha256": "2cdf3faa6c1aed208a7e7fc24b6ca69c8a329fe41ffd4faa409c2cc5cc6c93b6", "decisions_sha256": null, "evidence_build_id": "f826cdeb7fbc262e1674323070670587be772af004e2a8855ab00b9209fb5848", "pack_id": "NUPA-ISTP-2026-014+ADD-03-CANDIDATE", "readings_sha256": "16b1b63f693c0dbd0db29c29700dae71525df534d9f300373aa0fd3b