86b1f5b1b73e8b52e3817b7c29c409ea616489cca", "assumptions_sha256": "be5a1ecc966dab8d311cb4688827e56b9cd41f28053de21b5fb262fea446b1e0", "curation_sha256": "2cdf3faa6c1aed208a7e7fc24b6ca69c8a329fe41ffd4faa409c2cc5cc6c93b6", "decisions_sha256": null, "evidence_build_id": "f826cdeb7fbc262e1674323070670587be772af004e2a8855ab00b9209fb5848", "pack_id": "NUPA-ISTP-2026-014+ADD-03-CANDIDATE", "readings_sha256": "16b1b63f693c0dbd0db29c29700dae71525df534d9f300373aa0fd3b5d292bbf", "register_sha256": "8fa0072209651dfb94d0862e5cac287415c02ac8c85d7e02f0404990aa647ff5", "relationships_sha256": "1e6f35c25cd34a8718fff3d6ac2a8ce8b86821e3211c270742a64caa9b4c3052", "unrecorded_crops_sha256": null, "validated_stage": "ADD-02", "working_stage": "ADD-03"}, "statement_type": "disposition"}, {"evidence": [{"doc": "ADD-03", "kind": "span", "page": 1, "unit_id": "ADD-03:1.2", "words": "A reference in this Addendum to a Clause, Table or Form is to that Clause, Table or Form as amended by Addenda Nos. 1 and 2, unless otherwise stated."}], "id": "ADD-03/1.2", "payload": {"candidates": [], "disposition": "no_effect", "provision": "ADD-03:1.2", "reason": "Interpretation rule: 'A reference in this Addendum to a Clause, Table or Form is to that Clause, Table or Form as amended by Addenda Nos. 1 and 2, unless otherwise stated.' It amends no unit; it directs that targets are read as they stand at stage ADD-02, which is how ADD-03 ops are applied. The exception 'unless otherwise stated' changes nothing unless a later provision so states; a person confirms."}, "provision": "ADD-03:1.2", "state": {"activity_templates_sha256": "8f720c1d04e5f6d1926872e7bdeca2e28537782912cdc237796e2fe98e30d005", "amendments_sha256": "cec31d3931c953f5505c6db86b1f5b1b73e8b52e3817b7c29c409ea616489cca", "assumptions_sha256": "be5a1ecc966dab8d311cb4688827e56b9cd41f28053de21b5fb262fea446b1e0", "curation_sha256": "2cdf3faa6c1aed208a7e7fc24b6ca69c8a329fe41ffd4faa409c2cc5cc6c93b6", "decisions_sha256": null, "evidence_build_id": "f826c