+    else:
+        cfg["offline"] = True                                        # ai.yaml's key, nothing else
+        OFF.activate(cfg, OFF.requested(cfg))
+    assert OFF.is_offline(), switch
+    _direct_builds_refused(OFF)
+    assert guard.non_local() == [] and guard.processes == []
