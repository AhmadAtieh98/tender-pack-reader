+def _mcp(srv, n, args):
+    import json
+    r = srv.handle({"jsonrpc": "2.0", "id": n, "method": "tools/call",
+                    "params": {"name": "submit_proposals", "arguments": args}})
+    return json.loads(r["result"]["content"][0]["text"]), r["result"]["isError"]
